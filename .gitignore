__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Local editor / agent tooling config, not project content.
.claude/

# Measurement outputs are data, not source. They carry their own provenance
# (host, gpu_name, git_commit, segment_digest) and are joined by
# analysis/cross_arch.py; committing them would conflate "the code that
# produced a result" with "the result", which is the distinction the commit
# field exists to make.
results/
*.parquet

# Phase logs are measurement output too, and they are written INTO the repo
# by scripts/run_phase.sh. Leaving them untracked made `git status` non-empty
# on every rented instance, which made provenance.capture() stamp
# git_dirty=True on every row of Stage 0 and Stage 1 -- and a dirty stamp
# means the commit does not describe the code that ran, so those passes could
# not license Stage 2. The sync wrapper added to prevent data loss was
# invalidating the provenance of everything it wrapped.
logs/
